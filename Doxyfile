#
# Doxygen configuration. Every warning is an error: all C++ must be documented.

PROJECT_NAME           = "JamomaMax3"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = core externals
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = JAMOMA_API= "MIN_EXTERNAL(x)="
