{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macOS (Xcode, arm64 + x86_64)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/macos",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "windows",
      "displayName": "Windows (newest installed Visual Studio, x64)",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "macos", "configurePreset": "macos", "configuration": "Debug" },
    { "name": "windows", "configurePreset": "windows", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "macos", "configurePreset": "macos", "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows", "configurePreset": "windows", "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
